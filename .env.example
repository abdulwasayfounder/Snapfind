# Server-side Gemini API Key (Required for AI Vision OCR & Natural Language Search)
GEMINI_API_KEY=

# Node Runtime Environment
NODE_ENV=production

# Server Port Configuration (Port 3000 hardcoded for container ingress)
PORT=3000

# Client-Side Supabase Configuration (Public Anonymous Keys Only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Supabase Configuration (Secret Keys - Never Exposed to Client)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-Side Payment Configuration (Paddle Standardized)
PAYMENT_PROVIDER=paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=
PADDLE_PRICE_ID_LIFETIME=
PADDLE_PRICE_ID_FOUNDER=

# Client-Side Paddle Configuration (Public Safe Tokens Only - Never Secret Keys)
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID_MONTHLY=
VITE_PADDLE_PRICE_ID_YEARLY=
VITE_PADDLE_PRICE_ID_LIFETIME=
VITE_PADDLE_PRICE_ID_FOUNDER=

